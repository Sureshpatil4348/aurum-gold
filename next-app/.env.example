# ============================================================
# AURUM EA - Environment Variables
# Copy this file to .env.local and fill in real credentials.
# NEVER commit .env.local to version control.
# ============================================================

# ----------------------------
# Stripe (use test keys during development)
# ----------------------------
STRIPE_PUBLISHABLE_KEY=pk_test_dummy_key
STRIPE_SECRET_KEY=sk_test_dummy_key
STRIPE_WEBHOOK_SECRET=whsec_dummy_key
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_dummy_key

# ----------------------------
# Zoho Books
# ----------------------------
ZOHO_CLIENT_ID=dummy_client_id
ZOHO_CLIENT_SECRET=dummy_client_secret
ZOHO_REFRESH_TOKEN=dummy_refresh_token
ZOHO_ORGANIZATION_ID=dummy_organization_id

# ----------------------------
# Application URLs
# ----------------------------
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ----------------------------
# Email (Nodemailer / SMTP)
# ----------------------------
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=dev@example.com
SMTP_PASSWORD=dummy_smtp_password
EMAIL_FROM="AURUM EA <dev@example.com>"
EMAIL_TO=admin@example.com
